# Punch Configuration
# Copy this file to .env and fill in the three values below.
# Business details (name, address, etc.) are configured inside the app under Settings.

# --- Database ---
# These two passwords must match exactly.
POSTGRES_USER=punch
POSTGRES_PASSWORD=yourpassword
POSTGRES_DB=punch
DATABASE_URL=postgresql://punch:yourpassword@db:5432/punch

# --- App Security ---
# Generate a long random string. Run this in a terminal:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Or just mash your keyboard for 40+ random characters.
# Never change this after your first run — it will invalidate all sessions.
SECRET_KEY=change-this-to-a-long-random-string

# --- Timezone ---
TZ=America/New_York
